# Copy to .env.local (gitignored) for `npm run dev` / `npm run snapshot`.
# The same names go into Vercel → Settings → Environment Variables (Production + Preview).

# Notion Internal Integration secret (notion.so/profile/integrations). Share both databases with it.
NOTION_TOKEN=

# Login password for the site, at least 12 characters.
AUTH_PASSWORD=

# Session signing key, at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional: point at your own databases (data source ids, without the "collection://" prefix).
# NOTION_INFO_DS=3e627141-a910-80f6-b4de-000b0e86ddc4
# NOTION_PLAN_DS=d64bfa5d-3677-4546-83b4-80c81a00c727
